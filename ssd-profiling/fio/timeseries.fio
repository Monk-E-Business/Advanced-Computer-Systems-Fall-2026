; -----------------------------------------------------------------------------
; Long, logged run for device-state effects (burst -> steady state, SLC cache
; exhaustion, garbage collection, thermal throttling). Per-interval averages of
; bandwidth, IOPS and latency are written to ${LOGPREFIX}_{bw,iops,lat}.N.log
; every ${LOGMS} ms. Used with RW=randwrite BS=4k (steady state) and
; RW=write BS=128k (SLC write-cache cliff).
; -----------------------------------------------------------------------------
[global]
filename=${FIO_FILENAME}
cpus_allowed=${FIO_CPUS}
ioengine=${IOENGINE}
direct=1
time_based=1
runtime=${RUNTIME}
size=${SIZE}
refill_buffers=1
buffer_compress_percentage=${COMPRESS_PCT}
norandommap=1
randrepeat=0
lat_percentiles=1
clat_percentiles=0
percentile_list=50:95:99:99.9:99.99
thread=1
group_reporting=1
log_avg_msec=${LOGMS}
write_bw_log=${LOGPREFIX}
write_iops_log=${LOGPREFIX}
write_lat_log=${LOGPREFIX}

[job]
rw=${RW}
bs=${BS}
iodepth=${QD}
numjobs=${NJ}
