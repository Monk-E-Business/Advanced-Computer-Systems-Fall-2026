; -----------------------------------------------------------------------------
; I/O-path correctness check: write a region with per-block crc32c checksums +
; headers (offset, length, sequence), then read it back and verify. Proves the
; direct-I/O path returns exactly what was written at the right offsets before
; trusting any performance number. Uses ${SIZE} bytes at offset 0.
; -----------------------------------------------------------------------------
[global]
filename=${FIO_FILENAME}
cpus_allowed=${FIO_CPUS}
ioengine=${IOENGINE}
direct=1
size=${SIZE}
thread=1

[write-and-verify]
rw=randwrite
bs=4k
iodepth=16
verify=crc32c
verify_fatal=1
do_verify=1
verify_backlog=0
randrepeat=1
verify_state_save=0
