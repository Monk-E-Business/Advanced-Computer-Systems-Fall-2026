# =============================================================================
# SSD profiling configuration. Don't edit this file: put your overrides in
# config.local.env (git-ignored). The scripts load config.env first, then
# config.local.env. Every knob here is recorded in each run's metadata.
#
# Platform: Windows 11 + MSYS2 (UCRT64 shell) is the primary target. The same
# scripts also run on Linux; Linux-only notes are marked [Linux].
# =============================================================================

# ---- Target -----------------------------------------------------------------
# Option A (recommended): a large disposable file on the SSD under test, ideally
# on its own NTFS partition (e.g. D:). Write paths with forward slashes. The
# basename MUST contain "fio-scratch" (a guard against pointing at a real file).
# prepare_target.sh creates the file and writes it in full.
TARGET="D:/ssdtest/fio-scratch.bin"
#   [Linux] TARGET="/mnt/ssdtest/fio-scratch.bin"

# Option B: a whole, EMPTY second disk reserved for testing (Administrator shell).
#   TARGET='\\.\PhysicalDrive1'          [Linux] TARGET="/dev/nvme1n1"
# Raw disks also require ALLOW_RAW_DEVICE=1 and WIPE_OK set to exactly the same
# string. The scripts refuse the Windows system disk and any disk that still
# has partitions on it (delete them in Disk Management first).
# ALL DATA ON THE DISK WILL BE DESTROYED.
ALLOW_RAW_DEVICE=0
WIPE_OK=""

# Bytes of the target exercised (the LBA range / working set for "full range"
# tests). For a file target this is the file size. For a raw disk, leave it
# empty to use the whole disk, or limit the tested span (e.g. 200G).
# Pick >= 2-3x the drive's SLC cache.
TARGET_SIZE="64G"

# ---- Tools ------------------------------------------------------------------
FIO_BIN=""            # empty = auto: fio on PATH, else C:/Program Files/fio/fio.exe

# ---- Measurement discipline -------------------------------------------------
RUNTIME=30            # seconds measured per fio run
RAMP=5                # seconds discarded before measurement (warm-up)
REPS=3                # independent repetitions per point (error bars)
IOENGINE=""           # empty = auto: windowsaio on Windows, io_uring on Linux
FIO_CPUS="2-5"        # logical CPUs fio may run on (fio cpus_allowed). Keep off
                      # CPU 0; on Intel hybrid CPUs choose P-cores. Empty = all CPUs.
COMPRESS_PCT=0        # 0 = incompressible data (buffer refilled on every I/O)
QUICK="${QUICK:-0}"   # 1 = smoke-test mode: tiny runtimes/sizes, 1 rep, few points

# ---- Sweep definitions ------------------------------------------------------
BS_LIST="4k 16k 32k 64k 128k 256k"
BS_SEQ_EXTRA="512k 1m"          # extra block sizes for sequential only
BS_SWEEP_QD=32                  # fixed queue depth used for the block-size sweep
MIX_READ_PCTS="100 70 50 0"     # % reads for the read/write mix sweep
MIX_BS="4k"                     # block size for mix sweep
MIX_QD=32                       # queue depth for mix sweep
QD_LIST="1 2 4 8 16 32 64 128 256"   # TOTAL (effective) queue depth = iodepth * numjobs
# QD-sweep series as rw:bs:numjobs. The total QD is split across numjobs, so
# randread:4k:1 vs randread:4k:4 at the same total QD separates the limit of a
# single submitting CPU thread from the device's own queueing behaviour.
QD_SWEEP_SERIES="randread:4k:1 randread:4k:4 randwrite:4k:4 read:128k:1"
TAIL_QD_MID=""                  # empty = auto: knee/4 from the QD sweep (min 2)
TAIL_QD_KNEE=""                 # empty = auto: knee from the QD sweep
TAIL_RUNTIME_MULT=3             # tail runs are longer for stable p99.9/p99.99
WS_LIST="1G 4G 16G 32G FULL"    # working-set (LBA span) sweep for 4k random read
WS_QDS="1 32"
MISLEAD_WS="1G"                 # working set for the page-cache / unwritten-file demos

# ---- Device-state experiment ------------------------------------------------
PRECOND_SEQ_LOOPS=2             # full-span sequential fills before measurements
PRECOND_RAND_MULT=1             # random 4k writes = this many x span before measurements
SS_IDLE_BEFORE_SEC=300          # idle time before the SLC-cliff test so the drive can
                                # flush its SLC cache (burst state)
SS_POST_IDLE_SEC=120            # idle before the "reads after GC drained" check
SS_RANDWRITE_SECONDS=1800       # sustained 4k random write duration (steady state)
SS_SEQWRITE_SECONDS=600         # sustained 128k seq write duration (SLC cache cliff)
TEMP_SAMPLE_SEC=2               # temperature sampling period during runs

# ---- Optional -----------------------------------------------------------------
INTERFACE_GBPS=""               # override link ceiling in GB/s for plots (auto-detected
                                # from the PCIe link speed/width when empty)
